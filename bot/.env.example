# ===== WhatsApp Cloud API (Meta) =====
# Se obtienen en developers.facebook.com -> tu app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=pega_aqui_tu_token_de_acceso
WHATSAPP_PHONE_NUMBER_ID=pega_aqui_el_phone_number_id

# Token que TÚ inventas; debe ser el mismo que pongas en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=bikerpro_verify_123

# ID de la cuenta de WhatsApp Business (WhatsApp Business Account ID), sale en API Setup
WHATSAPP_WABA_ID=2213159576112051

# ===== IA — se elige el proveedor, no queda amarrado a uno =====
# Los precios de los modelos se movieron mucho en 2026 (Gemini Flash pasó de
# US$0.10 a US$0.75 por millón de tokens de entrada). Por eso el proveedor es
# una variable: cambiar de motor NO requiere tocar código.
#
# 🔄 COSTO RECALCULADO EL 21-SEP con datos MEDIDOS del export del agente
# (ver /analisis/costo-prompt-nuevo-21sep.py).
#
# La estimación anterior asumía 10 mensajes por conversación. El export de
# 6.317 conversaciones reales mide 3,43. Sobrecontaba las llamadas 2,9×, así
# que la IA cuesta bastante MENOS de lo que decía la cuenta vieja:
#
#   modelo                   IA/mes      + Render = total
#   Llama 3.1 8B (Groq)      $20.289      $28.000   $48.289
#   DeepSeek V4-Flash        $57.179      $28.000   $85.179   <- el más barato útil
#   GPT-5.6 Luna             $86.978      $28.000  $114.978
#   Gemini 3.1 Flash-Lite   $108.723      $28.000  $136.723   <- clave ya existe
#
# Contra ManyChat ($500.000+), respond.io ($796.000+) o Wati ($1.956.000).
#
# 👉 RECOMENDACIÓN: arrancar con Gemini (la clave ya existe y la facturación
#    está activa = cero fricción hoy) y pasar a DeepSeek esta semana, que
#    ahorra $51.544/mes. El cambio es esta variable, sin tocar código.

# --- Opción A: Gemini (clave gratis en https://aistudio.google.com/apikey) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=pega_aqui_tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Opción B: DeepSeek, Groq, OpenAI... (compatible con OpenAI) ---
# Para cambiar: poné AI_PROVIDER=openai-compat y llená estas tres.
# DeepSeek: https://platform.deepseek.com  → base https://api.deepseek.com
# Groq:     https://console.groq.com       → base https://api.groq.com/openai
# AI_PROVIDER=openai-compat
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# Cuántos mensajes del historial se envían al modelo (8 = 4 turnos).
# Subirlo mejora la memoria pero encarece cada respuesta.
MAX_HISTORIAL=8

# ===== Notificaciones de pedidos (opcional) =====
# Tu propio numero (con codigo pais, sin +) para recibir aviso de cada pedido
OWNER_WHATSAPP=573138615813

# ===== Medios de pago anticipado (opcional; si los pones, el bot los ofrece) =====
PAGO_NEQUI=
PAGO_BANCOLOMBIA=
PAGO_DAVIPLATA=
PAGO_BREB=

# ===== Fotos/Video del producto (URLs publicas https) =====
# Sube las imagenes/video (ej. a GitHub Pages) y pega aqui sus URLs
MEDIA_COLORES=
MEDIA_PRODUCTO=
MEDIA_VIDEO=

# Puerto (Render/Railway lo asignan automaticamente)
PORT=3000
